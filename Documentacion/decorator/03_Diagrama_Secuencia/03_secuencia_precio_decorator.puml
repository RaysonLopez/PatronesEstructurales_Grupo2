@startuml
!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 17
skinparam sequenceArrowThickness 2
skinparam sequenceParticipantBorderThickness 2
skinparam sequenceParticipantBorderColor #285E9B
skinparam sequenceLifeLineBorderColor #B7C8D9
skinparam sequenceLifeLineBackgroundColor #EAF2FB
skinparam sequenceArrowColor #285E9B
skinparam sequenceMessageAlign center
hide footbox

title FIGURA 03 | DIAGRAMA DE SECUENCIA — CÁLCULO DEL PRECIO

participant "Principal\nmostrarComputadora(titulo, computadora)" as P #EAF2FB
participant "completa:ConDiscoSsd" as SSD #FFF4E5
participant "ram:ConMemoriaExtra" as RAM #E8F5F1
participant "gpu:ConTarjetaGrafica" as GPU #E8F5F1
participant "base:ComputadoraBasica" as BASE #EAF2FB

P -> SSD : 1. getPrecio()
activate SSD
SSD -> RAM : 2. getPrecio()
activate RAM
RAM -> GPU : 3. getPrecio()
activate GPU
GPU -> BASE : 4. getPrecio()
activate BASE
BASE --> GPU : 5. $500.00
deactivate BASE
GPU --> RAM : 6. $750.00 = 500 + 250
deactivate GPU
RAM --> SSD : 7. $830.00 = 750 + 80
deactivate RAM
SSD --> P : 8. $950.00 = 830 + 120
deactivate SSD
@enduml
