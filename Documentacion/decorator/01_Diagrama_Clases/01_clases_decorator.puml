@startuml
!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam class {
  BackgroundColor white
  BorderColor #285E9B
  ArrowColor #285E9B
}
title FIGURA 01 | DIAGRAMA DE CLASES — PATRÓN DECORATOR

interface IComputadora {
  + getDescripcion(): String
  + getPrecio(): double
}

class ComputadoraBasica {
  - {static} PRECIO_BASE: double = 500.00
  + getDescripcion(): String
  + getPrecio(): double
}

abstract class DecoradorComputadora {
  # computadora: IComputadora {readOnly}
  # DecoradorComputadora(computadora: IComputadora)
  + getDescripcion(): String
  + getPrecio(): double
}

class ConTarjetaGrafica {
  - {static} PRECIO_EXTRA: double = 250.00
  + ConTarjetaGrafica(computadora: IComputadora)
  + getDescripcion(): String
  + getPrecio(): double
}
class ConMemoriaExtra {
  - {static} PRECIO_EXTRA: double = 80.00
  + ConMemoriaExtra(computadora: IComputadora)
  + getDescripcion(): String
  + getPrecio(): double
}
class ConDiscoSsd {
  - {static} PRECIO_EXTRA: double = 120.00
  + ConDiscoSsd(computadora: IComputadora)
  + getDescripcion(): String
  + getPrecio(): double
}

IComputadora <|.. ComputadoraBasica
IComputadora <|.. DecoradorComputadora
DecoradorComputadora <|-- ConTarjetaGrafica
DecoradorComputadora <|-- ConMemoriaExtra
DecoradorComputadora <|-- ConDiscoSsd
DecoradorComputadora "0..*" --> "1" IComputadora : envuelve
@enduml
