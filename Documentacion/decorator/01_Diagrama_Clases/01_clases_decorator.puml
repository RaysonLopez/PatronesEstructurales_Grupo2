@startuml
!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName "DejaVu Sans"
skinparam linetype ortho
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #285E9B
  ArrowColor #285E9B
}
title 01. Diagrama de clases — Patrón Decorator
caption Proyecto Java original · paquete ec.edu.espe.patrones.decorator

interface IComputadora <<Component>> {
  + getDescripcion(): String
  + getPrecio(): double
}

class ComputadoraBasica <<ConcreteComponent>> {
  - {static} PRECIO_BASE: double = 500.00
  + getDescripcion(): String
  + getPrecio(): double
}

abstract class DecoradorComputadora <<Decorator>> {
  # computadora: IComputadora {readOnly}
  # DecoradorComputadora(computadora: IComputadora)
  + getDescripcion(): String
  + getPrecio(): double
}

class ConTarjetaGrafica <<ConcreteDecorator>> {
  - {static} PRECIO_EXTRA: double = 250.00
  + ConTarjetaGrafica(computadora: IComputadora)
  + getDescripcion(): String
  + getPrecio(): double
}
class ConMemoriaExtra <<ConcreteDecorator>> {
  - {static} PRECIO_EXTRA: double = 80.00
  + ConMemoriaExtra(computadora: IComputadora)
  + getDescripcion(): String
  + getPrecio(): double
}
class ConDiscoSsd <<ConcreteDecorator>> {
  - {static} PRECIO_EXTRA: double = 120.00
  + ConDiscoSsd(computadora: IComputadora)
  + getDescripcion(): String
  + getPrecio(): double
}

IComputadora <|.. ComputadoraBasica : implementa
IComputadora <|.. DecoradorComputadora : implementa
DecoradorComputadora <|-- ConTarjetaGrafica
DecoradorComputadora <|-- ConMemoriaExtra
DecoradorComputadora <|-- ConDiscoSsd
DecoradorComputadora "0..*" --> "1" IComputadora : envuelve (computadora)

note right of DecoradorComputadora
  Tiene una referencia a IComputadora.
  Es una IComputadora y envuelve otra.
  Referencia final NO implica composición
  de ciclo de vida.
end note
@enduml
