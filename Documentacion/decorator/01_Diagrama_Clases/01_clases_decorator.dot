digraph UML_Clases {
  graph [rankdir=BT, bgcolor="white", pad="0.35", nodesep="0.5", ranksep="1.1", splines=polyline, fontname="DejaVu Sans", labelloc=t, label="FIGURA 01 | DIAGRAMA DE CLASES — PATRÓN DECORATOR", fontsize=23, fontcolor="#173451"];
  node [shape=plain, fontname="DejaVu Sans"];
  edge [fontname="DejaVu Sans", fontsize=14, color="#285E9B", penwidth=2.0, arrowsize=1.0];
  IComputadora [label=<<TABLE BORDER="1" COLOR="#0E857B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD BGCOLOR="#E8F5F1"><FONT POINT-SIZE="11">«interface»</FONT><BR/><FONT POINT-SIZE="17"><B>IComputadora</B></FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#D8E2EE"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">+ getDescripcion(): String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">+ getPrecio(): double</FONT></TD></TR></TABLE>>];
  ComputadoraBasica [label=<<TABLE BORDER="1" COLOR="#285E9B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD BGCOLOR="#EAF2FB"><FONT POINT-SIZE="11">Componente concreto</FONT><BR/><FONT POINT-SIZE="17"><B>ComputadoraBasica</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">- PRECIO_BASE: double = 500.00 {static, readOnly}</FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#D8E2EE"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">+ getDescripcion(): String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">+ getPrecio(): double</FONT></TD></TR></TABLE>>];
  DecoradorComputadora [label=<<TABLE BORDER="1" COLOR="#B97523" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD BGCOLOR="#FFF4E5"><FONT POINT-SIZE="11">Decorador base</FONT><BR/><FONT POINT-SIZE="17"><I>DecoradorComputadora</I></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13"># computadora: IComputadora {readOnly}</FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#D8E2EE"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13"># DecoradorComputadora(computadora: IComputadora)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">+ getDescripcion(): String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">+ getPrecio(): double</FONT></TD></TR></TABLE>>];
  ConTarjetaGrafica [label=<<TABLE BORDER="1" COLOR="#0E857B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD BGCOLOR="#E8F5F1"><FONT POINT-SIZE="11">Decorador concreto</FONT><BR/><FONT POINT-SIZE="17"><B>ConTarjetaGrafica</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">- PRECIO_EXTRA: double = 250.00 {static, readOnly}</FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#D8E2EE"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">+ ConTarjetaGrafica(computadora: IComputadora)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">+ getDescripcion(): String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">+ getPrecio(): double</FONT></TD></TR></TABLE>>];
  ConMemoriaExtra [label=<<TABLE BORDER="1" COLOR="#0E857B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD BGCOLOR="#E8F5F1"><FONT POINT-SIZE="11">Decorador concreto</FONT><BR/><FONT POINT-SIZE="17"><B>ConMemoriaExtra</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">- PRECIO_EXTRA: double = 80.00 {static, readOnly}</FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#D8E2EE"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">+ ConMemoriaExtra(computadora: IComputadora)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">+ getDescripcion(): String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">+ getPrecio(): double</FONT></TD></TR></TABLE>>];
  ConDiscoSsd [label=<<TABLE BORDER="1" COLOR="#0E857B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD BGCOLOR="#E8F5F1"><FONT POINT-SIZE="11">Decorador concreto</FONT><BR/><FONT POINT-SIZE="17"><B>ConDiscoSsd</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">- PRECIO_EXTRA: double = 120.00 {static, readOnly}</FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#D8E2EE"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">+ ConDiscoSsd(computadora: IComputadora)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">+ getDescripcion(): String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">+ getPrecio(): double</FONT></TD></TR></TABLE>>];
  {rank=same; ComputadoraBasica; DecoradorComputadora;}
  {rank=same; ConTarjetaGrafica; ConMemoriaExtra; ConDiscoSsd;}
  ComputadoraBasica -> IComputadora [arrowhead=empty, style=dashed, color="#0E857B"];
  DecoradorComputadora -> IComputadora [arrowhead=empty, style=dashed, color="#0E857B"];
  ConTarjetaGrafica -> DecoradorComputadora [arrowhead=empty];
  ConMemoriaExtra -> DecoradorComputadora [arrowhead=empty];
  ConDiscoSsd -> DecoradorComputadora [arrowhead=empty];
  DecoradorComputadora -> IComputadora [arrowhead=vee, constraint=false, color="#B97523", fontcolor="#B97523", label="envuelve", headlabel="1", taillabel="0..*", labeldistance=1.8, penwidth=2.0];
}
