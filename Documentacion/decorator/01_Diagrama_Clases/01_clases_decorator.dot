digraph UML_Clases {
  graph [rankdir=BT, bgcolor="white", fontname="DejaVu Sans", pad="0.40", nodesep="0.40", ranksep="1.30", splines=polyline, outputorder=edgesfirst, label="FIGURA 01  |  DIAGRAMA DE CLASES — PATRÓN DECORATOR\nProyecto: Simulador E-Commerce (implementación Java real)", labelloc=t, fontsize=19, fontcolor="#16324F"];
  node [shape=plain, fontname="DejaVu Sans"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#223149", penwidth=1.7, arrowsize=1.1];
  IComputadora [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#168A7B" BGCOLOR="#FFFFFF" WIDTH="290"><TR><TD BGCOLOR="#E9F7F3" ALIGN="CENTER"><FONT POINT-SIZE="10" COLOR="#52657D">«interface» / Component</FONT><BR/><FONT POINT-SIZE="13" COLOR="#16324F"><B>IComputadora</B></FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#168A7B"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT COLOR="#94A3B8">  —  </FONT></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#CCD7E4"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149">+ getDescripcion(): String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149">+ getPrecio(): double</FONT></TD></TR></TABLE>>];
  ComputadoraBasica [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#7194BD" BGCOLOR="#FFFFFF" WIDTH="390"><TR><TD BGCOLOR="#EAF2FB" ALIGN="CENTER"><FONT POINT-SIZE="10" COLOR="#52657D">ConcreteComponent</FONT><BR/><FONT POINT-SIZE="13" COLOR="#16324F"><B>ComputadoraBasica</B></FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#7194BD"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149">− PRECIO_BASE: double = 500.00 {static, final}</FONT></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#CCD7E4"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149">+ getDescripcion(): String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149">+ getPrecio(): double</FONT></TD></TR></TABLE>>];
  DecoradorComputadora [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#AD7220" BGCOLOR="#FFFFFF" WIDTH="475"><TR><TD BGCOLOR="#FFF6E8" ALIGN="CENTER"><FONT POINT-SIZE="10" COLOR="#52657D">«abstract» / Decorator</FONT><BR/><FONT POINT-SIZE="13" COLOR="#16324F"><I>DecoradorComputadora</I></FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#AD7220"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149"># computadora: IComputadora {final}</FONT></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#CCD7E4"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149"># DecoradorComputadora(computadora: IComputadora)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149">+ getDescripcion(): String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149">+ getPrecio(): double</FONT></TD></TR></TABLE>>];
  ConTarjetaGrafica [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#168A7B" BGCOLOR="#FFFFFF" WIDTH="430"><TR><TD BGCOLOR="#E9F7F3" ALIGN="CENTER"><FONT POINT-SIZE="10" COLOR="#52657D">ConcreteDecorator</FONT><BR/><FONT POINT-SIZE="13" COLOR="#16324F"><B>ConTarjetaGrafica</B></FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#168A7B"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149">− PRECIO_EXTRA: double = 250.00 {static, final}</FONT></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#CCD7E4"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149">+ ConTarjetaGrafica(computadora: IComputadora)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149">+ getDescripcion(): String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149">+ getPrecio(): double</FONT></TD></TR></TABLE>>];
  ConMemoriaExtra [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#168A7B" BGCOLOR="#FFFFFF" WIDTH="430"><TR><TD BGCOLOR="#E9F7F3" ALIGN="CENTER"><FONT POINT-SIZE="10" COLOR="#52657D">ConcreteDecorator</FONT><BR/><FONT POINT-SIZE="13" COLOR="#16324F"><B>ConMemoriaExtra</B></FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#168A7B"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149">− PRECIO_EXTRA: double = 80.00 {static, final}</FONT></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#CCD7E4"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149">+ ConMemoriaExtra(computadora: IComputadora)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149">+ getDescripcion(): String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149">+ getPrecio(): double</FONT></TD></TR></TABLE>>];
  ConDiscoSsd [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#168A7B" BGCOLOR="#FFFFFF" WIDTH="430"><TR><TD BGCOLOR="#E9F7F3" ALIGN="CENTER"><FONT POINT-SIZE="10" COLOR="#52657D">ConcreteDecorator</FONT><BR/><FONT POINT-SIZE="13" COLOR="#16324F"><B>ConDiscoSsd</B></FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#168A7B"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149">− PRECIO_EXTRA: double = 120.00 {static, final}</FONT></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#CCD7E4"></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149">+ ConDiscoSsd(computadora: IComputadora)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149">+ getDescripcion(): String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF" CELLPADDING="6"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#223149">+ getPrecio(): double</FONT></TD></TR></TABLE>>];
  {rank=same; ComputadoraBasica; DecoradorComputadora;}
  {rank=same; ConTarjetaGrafica; ConMemoriaExtra; ConDiscoSsd;}
  ConTarjetaGrafica -> DecoradorComputadora [arrowhead=empty, color="#285E9B"];
  ConMemoriaExtra -> DecoradorComputadora [arrowhead=empty, color="#285E9B"];
  ConDiscoSsd -> DecoradorComputadora [arrowhead=empty, color="#285E9B"];
  ComputadoraBasica -> IComputadora [arrowhead=empty, style=dashed, color="#168A7B", label="implementa", labeldistance=1.5];
  DecoradorComputadora -> IComputadora [arrowhead=empty, style=dashed, color="#168A7B", label="implementa", labeldistance=1.3];
  DecoradorComputadora -> IComputadora [arrowhead=vee, color="#AD7220", style=solid, constraint=false, label="envuelve / referencia 1", fontcolor="#AD7220", penwidth=2.0];
  subgraph cluster_leyenda { label="  Convenciones UML:  - privado    # protegido    + público  |  --▷ herencia    ..▷ realización (interface)  "; fontcolor="#64748B"; color="white"; fontsize=10; }
