@startuml
!theme plain
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam packageStyle rectangle
skinparam usecase {
  BorderColor #285E9B
  BackgroundColor #EAF2FB
  ArrowColor #285E9B
  FontColor #173451
}
skinparam actor {
  BorderColor #173451
  FontColor #173451
}

title FIGURA 02 | DIAGRAMA DE CASOS DE USO — DECORATOR

actor "Ejecutor de la
demostración" as Ejecutor
rectangle "Simulador de configuración de computadoras" {
  usecase "Ejecutar
demostración" as UC_Ejecutar
  usecase "Visualizar las tres
configuraciones" as UC_Visualizar
  usecase "Mostrar descripción y precio
de cada configuración" as UC_Mostrar
}
Ejecutor -- UC_Ejecutar
UC_Ejecutar ..> UC_Visualizar : <<include>>
UC_Visualizar ..> UC_Mostrar : <<include>>
@enduml
