digraph CasosDeUsoDecorator {
  graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.65", ranksep="1.1", splines=polyline, fontname="DejaVu Sans", labelloc=t, label="FIGURA 02 | DIAGRAMA DE CASOS DE USO — DECORATOR", fontsize=24, fontcolor="#173451"];
  node [fontname="DejaVu Sans", fontcolor="#173451", fontsize=18, color="#285E9B", penwidth=2.2];
  edge [fontname="DejaVu Sans", fontsize=15, color="#285E9B", penwidth=1.8, arrowsize=0.8];
  Ejecutor [shape=plaintext, label="◯\n╱│╲\n╱ ╲\nEjecutor de la\ndemostración"];
  subgraph cluster_Simulador {
    label="Simulador de configuración de computadoras";
    fontname="DejaVu Sans"; fontsize=21; fontcolor="#173451";
    style=rounded; penwidth=2; color="#285E9B"; bgcolor="#F8FAFD"; margin=28;
    ejecutar [shape=ellipse, style=filled, fillcolor="#EAF2FB", label="Ejecutar\ndemostración", width=3.0, height=1.25];
    visualizar [shape=ellipse, style=filled, fillcolor="#FFFFFF", label="Visualizar las tres\nconfiguraciones", width=3.2, height=1.25];
    mostrar [shape=ellipse, style=filled, fillcolor="#E8F5F1", label="Mostrar descripción y precio\nde cada configuración", width=4.0, height=1.3];
  }
  Ejecutor -> ejecutar [arrowhead=none];
  ejecutar -> visualizar [style=dashed, label="«include»", fontcolor="#285E9B"];
  visualizar -> mostrar [style=dashed, color="#0E857B", fontcolor="#0E857B", label="«include»"];
}
